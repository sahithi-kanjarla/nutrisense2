# Copy this file to .env and fill in the keys.

# Gemini (primary AI). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq (generic and fallback AI). Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: ask Groq to enforce a JSON schema. Only some Groq models support it (unverified here), so it is off by default.
# If Groq refuses it, the app falls back to plain JSON mode automatically.
GROQ_JSON_SCHEMA=false

# Server
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
DATABASE_PATH=./server/data/nutrisense.db
